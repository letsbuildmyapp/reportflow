# For local emulator runs, defaults are fine — leave VITE_USE_EMULATOR=true.
# At handoff Alex fills in real Firebase project values.
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=reportflow-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=reportflow-demo
VITE_FIREBASE_STORAGE_BUCKET=reportflow-demo.appspot.com
VITE_FIREBASE_MSG_SENDER_ID=0
VITE_FIREBASE_APP_ID=0
